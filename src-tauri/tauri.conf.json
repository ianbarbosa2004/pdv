{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDV Zanzibar",
  "version": "0.13.0",
  "identifier": "com.ianbarbosa2004.pdv",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDV Zanzibar",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "backgroundColor": "#f4f6f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Portuguese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "b7ae7388-17ff-5008-a042-60036fbb382e",
        "language": "pt-BR"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true
    }
  }
}
