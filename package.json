{
  "name": "pdv",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "node scripts/increment-version.mjs auto",
    "preview": "vite preview",
    "test": "node --test",
    "api": "node --env-file=.env src/server/server.js",
    "install:windows-api": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-api.ps1",
    "set:database-credential": "node --env-file=.env scripts/set-database-credential.mjs",
    "tauri": "tauri",
    "migrate:culinary-units": "node --env-file=.env scripts/migrations/migrate-culinary-units.mjs",
    "migrate:uppercase": "node --env-file=.env scripts/migrations/migrate-uppercase-data.mjs",
    "migrate:remove-nfce-certificate-path": "node --env-file=.env scripts/migrations/migrate-remove-nfce-certificate-path.mjs",
    "migrate:products-physical-state-fk": "node --env-file=.env scripts/migrations/migrate-products-physical-state-fk.mjs",
    "create:operator": "node --env-file=.env scripts/create-operator.mjs",
    "release:client": "node scripts/build-client-release.mjs",
    "prerelease:client": "node scripts/increment-version.mjs auto",
    "version:increment": "node scripts/increment-version.mjs patch",
    "version:auto": "node scripts/increment-version.mjs auto",
    "version:patch": "node scripts/increment-version.mjs patch",
    "version:minor": "node scripts/increment-version.mjs minor",
    "version:major": "node scripts/increment-version.mjs major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "keytar": "^7.9.0",
    "lucide": "^1.61.0",
    "mysql2": "^3.15.3",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  }
}
