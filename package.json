{
  "name": "pdv",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "api": "node --env-file=.env src/server/server.js",
    "install:windows-api": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-api.ps1",
    "set:database-credential": "node --env-file=.env scripts/set-database-credential.mjs",
    "tauri": "tauri",
    "tauri:dev:log": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/capture-cargo-log.ps1",
    "migrate:culinary-units": "node scripts/migrations/migrate-culinary-units.mjs",
    "migrate:unify-measurement-units": "node scripts/migrations/migrate-unify-measurement-units.mjs",
    "migrate:cutover-measurement-units": "node scripts/migrations/migrate-cutover-measurement-units.mjs",
    "migrate:uppercase": "node scripts/migrations/migrate-uppercase-data.mjs",
    "migrate:remove-nfce-certificate-path": "node scripts/migrations/migrate-remove-nfce-certificate-path.mjs",
    "migrate:products-physical-state-fk": "node scripts/migrations/migrate-products-physical-state-fk.mjs",
    "migrate:margin-balancers-group-only": "node scripts/migrations/migrate-margin-balancers-group-only.mjs",
    "migrate:recalculate-product-costs": "node scripts/migrations/migrate-recalculate-product-costs.mjs",
    "migrate:recalculate-recipe-usable-quantities": "node scripts/migrations/migrate-recalculate-recipe-usable-quantities.mjs",
    "create:operator": "node --env-file=.env scripts/create-operator.mjs",
    "release:client": "node scripts/build-client-release.mjs",
    "prerelease:client": "node scripts/increment-version.mjs hold",
    "version:increment": "node scripts/increment-version.mjs patch",
    "version:auto": "node scripts/increment-version.mjs auto",
    "version:patch": "node scripts/increment-version.mjs patch",
    "version:minor": "node scripts/increment-version.mjs minor",
    "version:major": "node scripts/increment-version.mjs major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.10.2",
    "air-datepicker": "^3.6.0",
    "keytar": "^7.9.0",
    "lucide": "^1.61.0",
    "mysql2": "^3.15.3",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  }
}
